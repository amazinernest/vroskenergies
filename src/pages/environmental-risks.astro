---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
---

<BaseLayout
  title="Environmental Risks Governance | Vrosk Energies"
  description="Learn how Vrosk Energies proactively manages environmental risks, oil spill containment, emissions reduction, and clean gas promotion."
  currentPath="/environmental-risks"
>
  <!-- Header -->
  <section class="section" style="padding-top: 60px; padding-bottom: 50px; background: #ffffff; border-bottom: 1px solid rgba(22,21,21,0.06);">
    <div class="container">
      <div style="max-width: 840px;">
        <div class="badge-pill mint">
          <span class="badge-dot"></span>
          <span>Ecological Responsibility</span>
        </div>
        <h1 class="heading-1" style="margin-bottom: 20px;">
          Environmental Risks & Climate Governance
        </h1>
        <p class="body-lead">
          We recognize the critical importance of protecting our ecosystems and managing environmental risks associated with physical hydrocarbon handling. We are committed to operating in a manner that is environmentally responsible and sustainable.
        </p>
      </div>
    </div>
  </section>

  <!-- Risk Mitigation Framework -->
  <section class="section">
    <div class="container">
      <div class="bento-hero-grid">
        <div class="bento-card" style="background: #ffffff; padding: 44px;">
          <div class="mono-tag" style="color: #0b4026; margin-bottom: 14px;">RISK GOVERNANCE</div>
          <h2 class="heading-2" style="font-size: 1.85rem; margin-bottom: 20px;">
            Proactive Protection of Marine & Coastal Ecosystems
          </h2>
          <p class="body-regular" style="margin-bottom: 18px; font-size: 1rem; line-height: 1.7;">
            As an energy trading and logistics enterprise, we understand that handling petroleum products involves inherent environmental exposure if not strictly managed. Our response is a comprehensive risk architecture encompassing preventive design, active surveillance, and rapid emergency containment.
          </p>
          <p class="body-regular" style="margin-bottom: 24px; font-size: 1rem; line-height: 1.7;">
            We implement environmental impact assessments (EIA) for all terminal operations, deploy certified vapor recovery units (VRU) to capture fugitive emissions during truck loading, and equip our maritime lightering operations with Tier-1 rapid-response spill containment gear adhering to MARPOL Annex I regulations.
          </p>
          <div style="background: var(--bg-color); border-radius: var(--radius-md); padding: 24px;">
            <h4 class="heading-4" style="font-size: 1.05rem; margin-bottom: 12px;">Environmental Directives</h4>
            <ul style="list-style: none; display: flex; flex-direction: column; gap: 10px; font-size: 0.925rem; color: var(--neutral-03);">
              <li>✓ Continuous bilge and ballast water management on all chartered product tankers</li>
              <li>✓ Routine soil and groundwater monitoring at bonded terminal tank farms</li>
              <li>✓ Promoting Liquefied Petroleum Gas (LPG) and Compressed Natural Gas (CNG) to cut particulate matter and sulfur oxide emissions</li>
              <li>✓ Zero routine flaring endorsement across all future upstream and marginal field assets</li>
            </ul>
          </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 24px;">
          <div class="bento-card-dark" style="background: var(--dark-surface-01);">
            <div class="mono-tag" style="color: var(--theme-color-01); margin-bottom: 12px;">CLEAN ENERGY TRANSITION</div>
            <h3 class="heading-3" style="color: #ffffff; font-size: 1.35rem; margin-bottom: 10px;">
              Displacing Dirty Fuels with Gas
            </h3>
            <p style="color: #a8a4a4; font-size: 0.925rem; line-height: 1.6;">
              By accelerating wholesale distribution of LPG and CNG, Vrosk actively helps industrial manufacturing plants convert heavy fuel oil (HFO) boilers to clean natural gas, cutting greenhouse gas emissions by up to 30%.
            </p>
          </div>

          <div class="bento-card" style="background: #ffffff;">
            <div class="mono-tag" style="color: #0b4026; margin-bottom: 12px;">REGULATORY COMPLIANCE</div>
            <h3 class="heading-3" style="font-size: 1.35rem; margin-bottom: 10px;">
              Statutory NMDPRA & NESREA Adherence
            </h3>
            <p class="body-regular" style="font-size: 0.925rem; line-height: 1.6;">
              Full compliance with the Nigerian Midstream and Downstream Petroleum Regulatory Authority (NMDPRA) environmental guidelines and National Environmental Standards Regulations.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTABanner />
</BaseLayout>
