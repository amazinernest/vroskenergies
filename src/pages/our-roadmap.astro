---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import { roadmapData } from '../data/roadmap';
---

<BaseLayout
  title="Our Growth RoadMap | Vrosk Energies"
  description="Discover where we are and where we are going with our strategic growth plan—expanding from physical trading into coastal terminal assets and modular refining."
  currentPath="/our-roadmap"
>
  <!-- Header -->
  <section class="section" style="padding-top: 60px; padding-bottom: 50px; background: #ffffff; border-bottom: 1px solid rgba(22,21,21,0.06);">
    <div class="container">
      <div style="max-width: 860px;">
        <div class="badge-pill mint">
          <span class="badge-dot"></span>
          <span>Corporate Strategic Plan</span>
        </div>
        <h1 class="heading-1" style="margin-bottom: 20px;">
          Our RoadMap: Where We Are versus Where We Are Going
        </h1>
        <p class="body-lead">
          At Vrosk Energies, we are committed to systematically expanding our asset footprint and infrastructure capabilities to secure sustainable long-term value across Africa’s energy landscape.
        </p>
      </div>
    </div>
  </section>

  <!-- Roadmap Timeline Matrix -->
  <section class="section">
    <div class="container">
      <div style="display: flex; flex-direction: column; gap: 40px;">
        {roadmapData.map((phase) => (
          <div class={`bento-card ${phase.status === 'active' ? '' : 'bento-card-dark'}`} style={`padding: 44px; ${phase.status === 'active' ? 'border: 2px solid #0d7543;' : ''}`}>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 16px; margin-bottom: 20px;">
              <div>
                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
                  <span style={`font-family: var(--font-mono); font-size: 0.8125rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; ${phase.status === 'active' ? 'color: #0b4026;' : 'color: var(--theme-color-01);'}`}>
                    {phase.stage} • {phase.phase}
                  </span>
                  <span style={`font-family: var(--font-mono); font-size: 0.75rem; padding: 2px 10px; border-radius: var(--radius-full); text-transform: uppercase; ${phase.status === 'active' ? 'background: rgba(77,255,176,0.25); color: #0b4026;' : 'background: rgba(255,255,255,0.1); color: #ffffff;'}`}>
                    {phase.status === 'active' ? '● CURRENT STAGE' : phase.status === 'in-progress' ? '◐ IN PROGRESS' : '○ FUTURE HORIZON'}
                  </span>
                </div>
                <h2 class="heading-2" style={`font-size: 2rem; ${phase.status !== 'active' ? 'color: #ffffff;' : ''}`}>
                  {phase.title}
                </h2>
              </div>
              <div style={`font-family: var(--font-mono); font-size: 0.8125rem; padding: 8px 16px; border-radius: var(--radius-sm); ${phase.status === 'active' ? 'background: var(--bg-alt); color: var(--neutral-04);' : 'background: rgba(255,255,255,0.06); color: var(--theme-color-01); border: 1px solid rgba(255,255,255,0.1);'}`}>
                {phase.metrics}
              </div>
            </div>

            <p style={`font-size: 1.05rem; line-height: 1.65; margin-bottom: 28px; max-width: 860px; ${phase.status === 'active' ? 'color: var(--neutral-03);' : 'color: #c4bfbf;'}`}>
              {phase.description}
            </p>

            <div style={`display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; padding: 24px; border-radius: var(--radius-md); ${phase.status === 'active' ? 'background: var(--bg-color);' : 'background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06);'}`}>
              {phase.items.map((item) => (
                <div style="display: flex; align-items: flex-start; gap: 10px;">
                  <span style={`font-weight: bold; ${phase.status === 'active' ? 'color: #0d7543;' : 'color: var(--theme-color-01);'}`}>
                    →
                  </span>
                  <span style={`font-size: 0.925rem; line-height: 1.6; ${phase.status === 'active' ? 'color: var(--neutral-04);' : 'color: #d6d3d3;'}`}>
                    {item}
                  </span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- Strategy Callout -->
      <div class="bento-card" style="margin-top: 48px; background: #ffffff; padding: 36px;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 24px;">
          <div style="max-width: 700px;">
            <h3 class="heading-3" style="font-size: 1.4rem; margin-bottom: 8px;">
              Investment & Co-Development Opportunities
            </h3>
            <p class="body-regular" style="font-size: 0.95rem;">
              We welcome institutional co-investors and terminal operators seeking equity participation in our coastal storage and modular refining projects.
            </p>
          </div>
          <a href="/contact-us" class="btn btn-primary">
            Partner With Our Strategy Desk
            <span class="btn-icon-circle">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <CTABanner />
</BaseLayout>
