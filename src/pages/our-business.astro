---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import ServicesBento from '../components/ServicesBento.astro';
---

<BaseLayout
  title="Our Business Model & Solutions | Vrosk Energies"
  description="Discover how Vrosk Energies delivers efficient, effective, and cost-friendly energy solutions across West Africa."
  currentPath="/our-business"
>
  <!-- Header -->
  <section class="section" style="padding-top: 60px; padding-bottom: 50px; background: #ffffff; border-bottom: 1px solid rgba(22,21,21,0.06);">
    <div class="container">
      <div style="max-width: 840px;">
        <div class="badge-pill mint">
          <span class="badge-dot"></span>
          <span>West African Energy Leadership</span>
        </div>
        <h1 class="heading-1" style="margin-bottom: 20px;">
          A Leading Integrated Player in the West African Energy Space
        </h1>
        <p class="body-lead">
          We assist our customers to achieve their desired energy outcomes in the most efficient, effective, and cost-friendly manner through innovative thinking, structured physical supply, and strategic capital partnerships.
        </p>
      </div>
    </div>
  </section>

  <!-- Business Architecture Bento Grid -->
  <section class="section">
    <div class="container">
      <div class="bento-hero-grid" style="margin-bottom: 56px;">
        <div class="bento-card" style="background: #ffffff; justify-content: space-between;">
          <div>
            <div class="mono-tag" style="color: #0b4026; margin-bottom: 12px;">BUSINESS MODEL</div>
            <h2 class="heading-2" style="font-size: 2rem; margin-bottom: 18px;">
              Integrated Physical Execution Backed by Institutional Structuring
            </h2>
            <p class="body-regular" style="margin-bottom: 16px;">
              Our commercial model is built on solving the structural friction points that plague emerging energy markets: high counterparty risk, currency volatility, inefficient logistics, and erratic supply.
            </p>
            <p class="body-regular" style="margin-bottom: 24px;">
              By operating across the complete downstream value chain—from international cargo origination to bonded tank farm storage, offshore STS operations, and inland distribution—we capture integrated margins while providing our clients guaranteed delivery certainty.
            </p>
          </div>
          <div style="display: flex; gap: 14px; flex-wrap: wrap;">
            <a href="/our-operation" class="btn btn-primary">
              Explore Our Field Operations
              <span class="btn-icon-circle">→</span>
            </a>
            <a href="/our-products-services" class="btn btn-secondary">
              Product Catalog
            </a>
          </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 24px;">
          <div class="bento-card-dark" style="background: var(--dark-surface-01);">
            <div class="mono-tag" style="color: var(--theme-color-01); margin-bottom: 12px;">CLIENT VALUE PROPOSITION</div>
            <h3 class="heading-3" style="color: #ffffff; font-size: 1.35rem; margin-bottom: 10px;">
              Cost Efficiency & Risk Shielding
            </h3>
            <p style="color: #b0acac; font-size: 0.925rem; line-height: 1.6;">
              We eliminate intermediaries by dealing directly with primary refiners and international commodity desks. Our paper-to-physical derivatives integration shields buyers from abrupt market rallies.
            </p>
          </div>

          <div class="bento-card" style="background: #ffffff;">
            <div class="mono-tag" style="color: #0b4026; margin-bottom: 12px;">COMMERCIAL AGILITY</div>
            <h3 class="heading-3" style="font-size: 1.35rem; margin-bottom: 10px;">
              Bespoke Delivery Contracts
            </h3>
            <p class="body-regular" style="font-size: 0.925rem; line-height: 1.6;">
              Whether off-taking through DAP coastal berths, STS open-sea coordinates, or rack truck deliveries at inland hubs, we tailor delivery terms to match client operational cycles.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Complete Services List -->
  <ServicesBento limit={8} />

  <CTABanner />
</BaseLayout>
