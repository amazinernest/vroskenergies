---
import { articlesData } from '../data/articles';

interface Props {
  limit?: number;
}

const { limit = 3 } = Astro.props;
const displayArticles = articlesData.slice(0, limit);
---

<section class="section" style="background: #ffffff;">
  <div class="container">
    <div class="section-header" style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 20px;">
      <div>
        <div class="badge-pill mint">
          <span class="badge-dot"></span>
          <span>Market Intelligence & Analysis</span>
        </div>
        <h2 class="heading-2">
          Latest Energy Insights & Briefs
        </h2>
      </div>
      <a href="/news-and-insights" class="btn btn-secondary">
        View All Articles & Briefings
        <span class="btn-icon-circle">→</span>
      </a>
    </div>

    <!-- Outgriid 3-Column Articles Bento Grid -->
    <div class="bento-grid-3">
      {displayArticles.map((article) => (
        <article class="bento-card" style="padding: 24px; justify-content: space-between;">
          <div>
            <div style="width: 100%; aspect-ratio: 16/10; border-radius: var(--radius-md); overflow: hidden; margin-bottom: 20px; background: var(--bg-alt);">
              <img 
                src={article.image} 
                alt={article.title}
                style="width: 100%; height: 100%; object-fit: cover; transition: transform var(--transition-normal);"
                loading="lazy"
              />
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; font-size: 0.8125rem; font-family: var(--font-mono); color: var(--neutral-03);">
              <span style="color: #0b4026; font-weight: 600;">{article.category}</span>
              <span>{article.readTime}</span>
            </div>

            <h3 class="heading-3" style="font-size: 1.25rem; margin-bottom: 12px; line-height: 1.35;">
              <a href={`/${article.slug}`} style="color: inherit;">
                {article.title}
              </a>
            </h3>

            <p class="body-regular" style="font-size: 0.9rem; line-height: 1.6; margin-bottom: 20px; color: var(--neutral-03);">
              {article.excerpt}
            </p>
          </div>

          <div style="padding-top: 16px; border-top: 1px solid rgba(22,21,21,0.08); display: flex; justify-content: space-between; align-items: center;">
            <span style="font-size: 0.8125rem; color: var(--neutral-03-light);">
              {article.date}
            </span>
            <a href={`/${article.slug}`} style="font-weight: 600; font-size: 0.875rem; color: var(--neutral-04); display: flex; align-items: center; gap: 4px;">
              Read Full Brief →
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
