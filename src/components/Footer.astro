---
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <!-- Col 1: Brand & Office -->
      <div class="footer-brand">
        <a href="/" aria-label="Vrosk Energies">
          <img 
            src="/assets/vrosk-logo-transparent.png" 
            alt="Vrosk Energies" 
            style="height: 38px; width: auto; filter: brightness(0) invert(1);" 
          />
        </a>
        <p>
          A premier Pan-African integrated energy enterprise providing physical commodities trading, supply chain risk structuring, storage logistics, and clean gas solutions across West Africa and international markets.
        </p>
        <div style="display: flex; flex-direction: column; gap: 8px; font-size: 0.875rem; color: var(--dark-text-muted);">
          <div>
            <strong style="color: #ffffff;">Headquarters:</strong><br />
            6 Tunde Fisayo Street, Off Ayinde Akinmade,<br />
            Lekki Phase 1, Lagos, Nigeria
          </div>
          <div style="margin-top: 6px;">
            <strong style="color: #ffffff;">Email Desk:</strong><br />
            <a href="mailto:info@vroskenergies.com" style="color: var(--theme-color-01); text-decoration: underline;">
              info@vroskenergies.com
            </a>
          </div>
        </div>
      </div>

      <!-- Col 2: Company & Governance -->
      <div>
        <h4 class="footer-col-title">Corporate</h4>
        <ul class="footer-links">
          <li><a href="/our-company-overview" class="footer-link">Company Overview</a></li>
          <li><a href="/our-core-values" class="footer-link">Our Core Values</a></li>
          <li><a href="/our-competence" class="footer-link">Core Competencies</a></li>
          <li><a href="/our-roadmap" class="footer-link">Growth RoadMap</a></li>
          <li><a href="/management-team" class="footer-link">Executive Management</a></li>
          <li><a href="/sustainability" class="footer-link">HSE & Sustainability</a></li>
          <li><a href="/community-relations-csr" class="footer-link">Community & CSR</a></li>
        </ul>
      </div>

      <!-- Col 3: Energy Solutions -->
      <div>
        <h4 class="footer-col-title">Operations</h4>
        <ul class="footer-links">
          <li><a href="/our-business" class="footer-link">Business Model</a></li>
          <li><a href="/our-operation" class="footer-link">Offshore & Terminal Logistics</a></li>
          <li><a href="/our-products-services" class="footer-link">Heavy Products (Bitumen & Base Oils)</a></li>
          <li><a href="/our-products-services" class="footer-link">White Products (PMS, AGO, Jet)</a></li>
          <li><a href="/our-products-services" class="footer-link">Gas Sales (LPG, CNG, LNG)</a></li>
          <li><a href="/our-products-services" class="footer-link">Derivatives & Paper Trading</a></li>
          <li><a href="/krosk-partners-limited" class="footer-link">Capital Markets Partner</a></li>
        </ul>
      </div>

      <!-- Col 4: Newsletter & Market Wire -->
      <div>
        <h4 class="footer-col-title">Energy Intelligence</h4>
        <p style="font-size: 0.875rem; color: var(--dark-text-muted); margin-bottom: 16px;">
          Subscribe to our executive market intelligence briefing on West African crude flows, gas contracts, and product supply dynamics.
        </p>

        <form class="footer-newsletter-form" id="newsletterForm" onsubmit="event.preventDefault(); document.getElementById('newsletterSuccess').style.display='block'; document.getElementById('newsletterForm').style.display='none';">
          <input 
            type="email" 
            placeholder="Enter corporate email" 
            required 
            class="footer-newsletter-input" 
            aria-label="Email address for energy briefing"
          />
          <button type="submit" class="footer-newsletter-btn">
            Subscribe
          </button>
        </form>

        <div id="newsletterSuccess" style="display: none; padding: 12px; background: rgba(77,255,176,0.12); border: 1px solid var(--theme-color-01); border-radius: 8px; color: var(--theme-color-01); font-size: 0.875rem; margin-top: 12px;">
          ✓ Thank you. You are now subscribed to Vrosk Energy Intelligence.
        </div>

        <div style="margin-top: 24px; display: flex; align-items: center; gap: 10px;">
          <span class="badge-dot"></span>
          <span style="font-size: 0.8125rem; font-family: var(--font-mono); color: var(--dark-text-muted);">
            LEKKI TRADING DESK: ACTIVE
          </span>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <div>
        © 2026 Vrosk Energies Limited. All rights reserved. Pan-African Energy Infrastructure.
      </div>
      <div class="footer-bottom-links">
        <a href="/sustainability" class="footer-link">Governance & HSE</a>
        <a href="/environmental-risks" class="footer-link">Environmental Policy</a>
        <a href="/contact-us" class="footer-link">Desk Directory</a>
      </div>
    </div>
  </div>
</footer>
