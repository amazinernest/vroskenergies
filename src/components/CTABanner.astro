<section class="section" style="padding-top: 40px; padding-bottom: 90px;">
  <div class="container">
    <div class="bento-card-dark" style="padding: clamp(36px, 6vw, 72px); border-radius: var(--radius-xl); text-align: center; position: relative; overflow: hidden; background: linear-gradient(135deg, #161515 0%, #1e1d1d 50%, #0d281a 100%);">
      <!-- Background Ambient Glow -->
      <div style="position: absolute; top: -50%; left: 50%; transform: translateX(-50%); width: min(600px, 100%); height: 300px; background: radial-gradient(circle, rgba(77,255,176,0.12) 0%, transparent 70%); pointer-events: none;"></div>

      <div style="position: relative; z-index: 1; max-width: 760px; margin: 0 auto;">
        <div class="badge-pill dark" style="margin: 0 auto 20px auto; background: rgba(77,255,176,0.15); border-color: var(--theme-color-01); color: var(--theme-color-01);">
          <span class="badge-dot"></span>
          <span>Pan-African Commercial Engagement</span>
        </div>

        <h2 class="heading-1" style="color: #ffffff; margin-bottom: 20px; font-size: clamp(1.75rem, 3.5vw, 2.75rem); line-height: 1.2;">
          Ready to Secure Reliable Downstream Offtake & Energy Infrastructure?
        </h2>

        <p style="color: #c4bfbf; font-size: clamp(1rem, 1.2vw, 1.15rem); margin-bottom: 36px; line-height: 1.65;">
          Connect directly with our physical trading desk at Lekki Phase 1, Lagos. We structure bespoke bulk import contracts, terminal storage access, STS transfers, and paper hedging for major industrial offtakers and retail networks.
        </p>

        <div style="display: flex; gap: 16px; justify-content: center; align-items: center; flex-wrap: wrap;">
          <a href="/contact-us" class="btn btn-mint">
            Inquire with Trading Desk
            <span class="btn-icon-circle" style="background: rgba(0,0,0,0.15);">→</span>
          </a>
          <a href="/our-products-services" class="btn btn-ghost-dark">
            Browse All 8 Product Verticals
          </a>
        </div>

        <div style="margin-top: 36px; display: flex; justify-content: center; align-items: center; gap: 24px; flex-wrap: wrap; font-size: 0.8125rem; font-family: var(--font-mono); color: var(--dark-text-muted);">
          <span>✓ Direct Refinery Cargo Sourcing</span>
          <span>✓ Licensed NMDPRA Compliance</span>
          <span>✓ Letter of Credit Structuring</span>
        </div>
      </div>
    </div>
  </div>
</section>
