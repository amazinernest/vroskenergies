---
import { servicesData } from '../data/services';

interface Props {
  limit?: number;
  showAllLink?: boolean;
}

const { limit = 8, showAllLink = false } = Astro.props;
const displayServices = servicesData.slice(0, limit);
---

<section class="section" style="background-color: #ffffff; border-top: 1px solid rgba(22,21,21,0.06); border-bottom: 1px solid rgba(22,21,21,0.06);">
  <div class="container">
    <div class="section-header" style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 24px;">
      <div>
        <div class="badge-pill mint">
          <span class="badge-dot"></span>
          <span>Comprehensive Downstream Capabilities</span>
        </div>
        <h2 class="heading-2">
          End-to-End Energy Products & Infrastructure Services
        </h2>
      </div>
      <p class="body-regular" style="max-width: 420px;">
        Dedicated to providing efficient, reliable, and cost-effective physical cargo solutions, storage logistics, and financial engineering.
      </p>
    </div>

    <!-- Outgriid Bento Grid for Services -->
    <div class="bento-grid-3">
      {displayServices.map((service, index) => (
        <div class="bento-card" style={`display: flex; flex-direction: column; justify-content: space-between; ${index === 0 || index === 4 ? 'background: #fdfdfd;' : ''}`}>
          <div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 10px; margin-bottom: 20px;">
              <span class="mono-tag" style="color: #0b4026; background: rgba(77,255,176,0.14); padding: 4px 10px; border-radius: var(--radius-full); line-height: 1.4; display: inline-block;">
                {service.tag}
              </span>
              <span style="font-size: 1.5rem; flex-shrink: 0;" aria-hidden="true">{service.icon}</span>
            </div>

            <h3 class="heading-3" style="font-size: 1.25rem; margin-bottom: 12px; line-height: 1.3;">
              {service.title}
            </h3>

            <p class="body-regular" style="font-size: 0.925rem; margin-bottom: 20px; line-height: 1.6;">
              {service.summary}
            </p>

            <ul style="list-style: none; display: flex; flex-direction: column; gap: 8px; margin-bottom: 24px;">
              {service.details.slice(0, 2).map((item) => (
                <li style="font-size: 0.8125rem; color: var(--neutral-03); display: flex; align-items: flex-start; gap: 8px;">
                  <span style="color: #0d7543; font-weight: bold;">•</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <div style="padding-top: 18px; border-top: 1px solid rgba(22,21,21,0.08); display: flex; align-items: center; justify-content: space-between;">
            <span style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--neutral-03-light); text-transform: uppercase;">
              {service.category}
            </span>
            <a href="/our-products-services" style="font-weight: 600; font-size: 0.875rem; color: var(--neutral-04); display: flex; align-items: center; gap: 4px;">
              Inquire Desk →
            </a>
          </div>
        </div>
      ))}
    </div>

    {showAllLink && (
      <div style="margin-top: 48px; text-align: center;">
        <a href="/our-products-services" class="btn btn-secondary">
          View All 8 Energy Verticals & Specifications
          <span class="btn-icon-circle">→</span>
        </a>
      </div>
    )}
  </div>
</section>
