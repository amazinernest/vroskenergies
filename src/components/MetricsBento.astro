<section class="section" style="padding-top: 20px; padding-bottom: 80px;">
  <div class="container">
    <div class="stats-banner">
      <div class="stats-grid">
        <!-- Stat 1 -->
        <div class="stat-item">
          <div class="stat-number">
            <span data-counter="200" data-counter-prefix="$" data-counter-suffix="M+">$200M+</span>
          </div>
          <div class="stat-label">
            Investment Portfolio Valuation Backing (Trosk)
          </div>
          <p style="font-size: 0.8125rem; color: var(--dark-text-muted); margin-top: 8px;">
            Pan-African energy portfolio originated through Dubai-based Trosk investment group.
          </p>
        </div>

        <!-- Stat 2 -->
        <div class="stat-item">
          <div class="stat-number">
            <span data-counter="150" data-counter-prefix="$" data-counter-suffix="M+">$150M+</span>
          </div>
          <div class="stat-label">
            Asset Synergy Under Management (Zrosk)
          </div>
          <p style="font-size: 0.8125rem; color: var(--dark-text-muted); margin-top: 8px;">
            SEC-licensed asset management synergy across private credit and trading verticals.
          </p>
        </div>

        <!-- Stat 3 -->
        <div class="stat-item">
          <div class="stat-number">
            <span data-counter="10" data-counter-suffix="+">10+</span>
          </div>
          <div class="stat-label">
            Core Energy Commodities & Gas Solutions
          </div>
          <p style="font-size: 0.8125rem; color: var(--dark-text-muted); margin-top: 8px;">
            Full downstream spectrum covering white products, heavy oils, LPG, and LNG.
          </p>
        </div>

        <!-- Stat 4 -->
        <div class="stat-item">
          <div class="stat-number">
            <span data-counter="100" data-counter-suffix="%">100%</span>
          </div>
          <div class="stat-label">
            HSE & Regulatory Compliance Rate
          </div>
          <p style="font-size: 0.8125rem; color: var(--dark-text-muted); margin-top: 8px;">
            Rigorous adherence to international MARPOL, OCIMF, and Nigerian NMDPRA standards.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
