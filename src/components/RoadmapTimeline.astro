---
import { roadmapData } from '../data/roadmap';
---

<section class="section" style="background-color: var(--dark-surface-01); color: #ffffff; position: relative;">
  <div class="container">
    <div class="section-header" style="max-width: 800px;">
      <div class="badge-pill dark" style="background: rgba(77,255,176,0.12); border-color: var(--theme-color-01); color: var(--theme-color-01);">
        <span class="badge-dot"></span>
        <span>Strategic Evolution</span>
      </div>
      <h2 class="heading-2" style="color: #ffffff;">
        Where We Are versus Where We Are Going
      </h2>
      <p style="color: #b0acac; font-size: 1.05rem; margin-top: 14px;">
        Vrosk Energies operates with an ambitious growth trajectory—moving from physical commodity trading to proprietary coastal storage terminal ownership, offshore maritime fleets, and modular refining.
      </p>
    </div>

    <!-- Outgriid Comparison Matrix Bento Cards -->
    <div style="display: flex; flex-direction: column; gap: 32px;">
      {roadmapData.map((stage, idx) => (
        <div class="bento-card-dark" style={`border-color: ${stage.status === 'active' ? 'var(--theme-color-01)' : 'var(--dark-border)'};`}>
          <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 16px; margin-bottom: 24px;">
            <div>
              <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
                <span style="font-family: var(--font-mono); font-size: 0.8125rem; color: var(--theme-color-01); text-transform: uppercase; letter-spacing: 0.08em;">
                  {stage.stage}
                </span>
                <span style={`font-family: var(--font-mono); font-size: 0.75rem; padding: 2px 10px; border-radius: var(--radius-full); text-transform: uppercase; ${stage.status === 'active' ? 'background: rgba(77,255,176,0.2); color: var(--theme-color-01);' : stage.status === 'in-progress' ? 'background: rgba(255,255,255,0.12); color: #ffffff;' : 'background: rgba(255,255,255,0.06); color: var(--dark-text-muted);'}`}>
                  {stage.status === 'active' ? '● Currently Active' : stage.status === 'in-progress' ? '◐ In Progress' : '○ Long-Term Horizon'}
                </span>
              </div>
              <h3 class="heading-3" style="color: #ffffff;">
                {stage.title}
              </h3>
            </div>
            
            <div style="font-family: var(--font-mono); font-size: 0.8125rem; color: var(--theme-color-01); background: rgba(255,255,255,0.05); padding: 8px 16px; border-radius: var(--radius-sm); border: 1px solid rgba(255,255,255,0.1);">
              {stage.metrics}
            </div>
          </div>

          <p style="color: #a8a4a4; font-size: 0.95rem; margin-bottom: 28px; line-height: 1.65; max-width: 880px;">
            {stage.description}
          </p>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 18px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,0.1);">
            {stage.items.map((item) => (
              <div style="background: rgba(255,255,255,0.03); padding: 18px; border-radius: var(--radius-md); border: 1px solid rgba(255,255,255,0.06);">
                <div style="font-size: 0.875rem; color: #d6d3d3; line-height: 1.6;">
                  {item}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div style="margin-top: 48px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px;">
      <p style="font-size: 0.875rem; color: var(--dark-text-muted);">
        Corporate roadmap ratified by Vrosk Energies Board of Directors & Investment Committee.
      </p>
      <a href="/our-roadmap" class="btn btn-mint">
        Explore Complete RoadMap
        <span class="btn-icon-circle" style="background: rgba(0,0,0,0.15);">→</span>
      </a>
    </div>
  </div>
</section>
