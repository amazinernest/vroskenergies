---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  currentPath?: string;
}

const {
  title = 'Vrosk Energies | Integrated Pan-African Energy, Trading & Infrastructure',
  description = 'Vrosk Energies is an integrated Pan-African energy powerhouse specializing in downstream petroleum trading, storage logistics, gas infrastructure, and derivatives risk structuring in West Africa.',
  ogImage = '/assets/oil-rig-hero.webp',
  currentPath = Astro.url.pathname,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://vroskenergies.com');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/assets/vrosk-favicon.png" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Geist:wght@300;400;500;600;700&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet" />

    <!-- Schema.org Organization Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "EnergyCompany",
      "name": "Vrosk Energies",
      "url": "https://vroskenergies.com",
      "logo": "https://vroskenergies.com/assets/vrosk-logo.png",
      "description": description,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "6 Tunde Fisayo, off Ayinde Akinmade",
        "addressLocality": "Lekki Phase 1",
        "addressRegion": "Lagos",
        "addressCountry": "NG"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "info@vroskenergies.com",
        "contactType": "trading and inquiries desk"
      }
    })} />
  </head>
  <body>
    <Header currentPath={currentPath} />
    
    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <!-- Global Executive Profile Modal -->
    <div class="team-modal-backdrop" id="teamModalBackdrop" role="dialog" aria-modal="true" aria-labelledby="modalMemberName">
      <div class="team-modal-card">
        <button class="team-modal-close" id="teamModalClose" aria-label="Close Profile">✕</button>
        <div style="display: flex; gap: 32px; align-items: flex-start; flex-wrap: wrap;">
          <div style="width: 140px; height: 140px; border-radius: var(--radius-lg); overflow: hidden; flex-shrink: 0; background: var(--bg-alt); border: 1px solid rgba(22,21,21,0.08);">
            <img id="modalMemberImg" src="" alt="" style="width: 100%; height: 100%; object-fit: cover;" />
          </div>
          <div style="flex: 1; min-width: min(100%, 240px);">
            <div class="badge-pill mint" id="modalMemberDept">Executive Leadership</div>
            <h2 id="modalMemberName" class="heading-3" style="margin-bottom: 6px;"></h2>
            <p id="modalMemberRole" style="font-family: var(--font-mono); font-size: 0.875rem; color: #0b4026; font-weight: 600; margin-bottom: 20px;"></p>
            <div id="modalMemberBio" style="font-size: 0.95rem; line-height: 1.7; color: var(--neutral-03);"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Client-side Interactions -->
    <script>
      // 1. Sticky Header Scroll Effect
      const header = document.getElementById('siteHeader');
      if (header) {
        window.addEventListener('scroll', () => {
          if (window.scrollY > 30) {
            header.classList.add('scrolled');
          } else {
            header.classList.remove('scrolled');
          }
        }, { passive: true });
      }

      // 2. Mobile Nav Drawer Toggle
      const mobileToggle = document.getElementById('mobileNavToggle');
      const mobileDrawer = document.getElementById('mobileDrawer');
      const mobileClose = document.getElementById('mobileDrawerClose');

      if (mobileToggle && mobileDrawer) {
        mobileToggle.addEventListener('click', () => {
          mobileDrawer.classList.add('open');
          document.body.style.overflow = 'hidden';
        });
      }

      if (mobileClose && mobileDrawer) {
        mobileClose.addEventListener('click', () => {
          mobileDrawer.classList.remove('open');
          document.body.style.overflow = '';
        });
      }

      // 3. Global Modal Logic for Team Profiles
      const teamBackdrop = document.getElementById('teamModalBackdrop');
      const modalClose = document.getElementById('teamModalClose');
      const modalName = document.getElementById('modalMemberName');
      const modalRole = document.getElementById('modalMemberRole');
      const modalBio = document.getElementById('modalMemberBio');
      const modalImg = document.getElementById('modalMemberImg') as HTMLImageElement;
      const modalDept = document.getElementById('modalMemberDept');

      function openModal(data: { name: string; role: string; bio: string; img: string; dept?: string }) {
        if (!teamBackdrop || !modalName || !modalRole || !modalBio || !modalImg) return;
        modalName.textContent = data.name;
        modalRole.textContent = data.role;
        modalBio.innerHTML = data.bio;
        modalImg.src = data.img;
        modalImg.alt = data.name;
        if (modalDept) modalDept.textContent = data.dept || 'Executive Leadership';
        teamBackdrop.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        if (!teamBackdrop) return;
        teamBackdrop.classList.remove('active');
        document.body.style.overflow = '';
      }

      if (modalClose) {
        modalClose.addEventListener('click', closeModal);
      }

      if (teamBackdrop) {
        teamBackdrop.addEventListener('click', (e) => {
          if (e.target === teamBackdrop) closeModal();
        });
      }

      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeModal();
          if (mobileDrawer) {
            mobileDrawer.classList.remove('open');
            document.body.style.overflow = '';
          }
        }
      });

      // Bind all profile buttons
      document.querySelectorAll('[data-team-trigger]').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const target = btn as HTMLElement;
          openModal({
            name: target.dataset.name || '',
            role: target.dataset.role || '',
            bio: target.dataset.bio || '',
            img: target.dataset.img || '',
            dept: target.dataset.dept || 'Executive Profile'
          });
        });
      });

      // 4. Metric Number Counter Animation
      const counters = document.querySelectorAll('[data-counter]');
      if ('IntersectionObserver' in window && counters.length > 0) {
        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const el = entry.target as HTMLElement;
              const targetVal = parseFloat(el.dataset.counter || '0');
              const prefix = el.dataset.counterPrefix || '';
              const suffix = el.dataset.counterSuffix || '';
              const duration = 1600;
              const startTime = performance.now();

              function updateNumber(now: number) {
                const elapsed = now - startTime;
                const progress = Math.min(elapsed / duration, 1);
                // Ease out exponential
                const ease = progress === 1 ? 1 : 1 - Math.pow(2, -10 * progress);
                const current = Math.floor(ease * targetVal);
                el.textContent = `${prefix}${current}${suffix}`;
                if (progress < 1) {
                  requestAnimationFrame(updateNumber);
                } else {
                  el.textContent = `${prefix}${targetVal}${suffix}`;
                }
              }

              requestAnimationFrame(updateNumber);
              obs.unobserve(el);
            }
          });
        }, { threshold: 0.2 });

        counters.forEach(c => observer.observe(c));
      }
    </script>
  </body>
</html>
